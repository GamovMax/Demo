<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<!--
   Файл конфигурации тестов
   Параметр TypeBrowser - тип запуска драйвера варианты:RemoteThread, Remote, Chrome, ChromeHeadless.
-->
<suite name="SmokeTests">
    <parameter name="TypeBrowser" value="Chrome"/>
    <test name="LiteCart">
        <classes>

            <!-- Тест авторизации -->
            <class name="tests.ui.TestLogin">
                <methods>
                    <include name="testLogin"/>
                </methods>
            </class>

            <!-- Тест меню -->
            <class name="tests.ui.TestMenu">
                <methods>
                    <include name="testAdminPageMenu"/>
                </methods>
            </class>

            <!-- Тест заголовков -->
            <class name="tests.ui.TestHeading">
                <methods>
                    <include name="testCheckHeading"/>
                </methods>
            </class>

            <!-- Тест добавления нового товара -->
            <class name="tests.ui.TestCatalogAdd">
                <methods>
                    <include name="testCatalogAdd"/>
                </methods>
            </class>

            <!-- Тест проверки стикеров в каталоге -->
            <class name="tests.ui.TestCatalogStickers">
                <methods>
                    <include name="testCatalogStickers"/>
                </methods>
            </class>

            <!-- Тест проверки логов -->
            <class name="tests.ui.TestCatalogLogs">
                <methods>
                    <include name="testCatalogLogs"/>
                </methods>
            </class>

            <!-- Тест создания аккаунта -->
            <class name="tests.ui.TestCreateAccount">
                <methods>
                    <include name="testCreateAccount"/>
                </methods>
            </class>

        </classes>
    </test>
</suite>
